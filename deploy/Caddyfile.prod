{
	# timeouts e limite de cabeçalho: mitigam conexões lentas (slowloris) e cabeçalhos gigantes
	servers {
		timeouts {
			read_header 10s
			read_body 120s
			write 120s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$APP_DOMINIO} {
	encode gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy app:8765
}
