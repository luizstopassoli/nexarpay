# Copie para ../.env e preencha (chmod 600 .env). NUNCA envie ao Git.
APP_DOMINIO=pay.seudominio.com.br
# domínio permitido nos e-mails dos usuários
APP_EMAIL_DOMINIO=seudominio.com.br
# Antes de subir: crie config.json (a partir de config.example.json) com o SMTP e url_base https://APP_DOMINIO
# Na 1ª execução as senhas iniciais são aleatórias e ficam em data/credenciais-iniciais.txt (dentro do volume): leia, troque e apague.
# Chave que cifra credenciais e dados bancários no banco. Gere:  openssl rand -base64 36
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela, os dados cifrados (inclusive os de um backup) não podem ser lidos.
APP_SECRET_KEY=
# Antivírus ClamAV (recomendado em produção): CLAMAV_HOST=clamav, AV_OBRIGATORIO=1 e subir com:  docker compose --profile av up -d --build
CLAMAV_HOST=
AV_OBRIGATORIO=0
# Primeiro administrador (o sistema NÃO cria usuários de exemplo em produção). A senha provisória fica em
# /app/data/credenciais-iniciais.txt:  docker compose exec app cat /app/data/credenciais-iniciais.txt  (apague após o 1º login: é apagado ao trocar a senha)
APP_ADMIN_EMAIL=admin@seudominio.com.br
APP_ADMIN_NOME=Administrador
