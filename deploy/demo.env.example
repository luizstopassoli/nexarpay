# Copie para ../.env e preencha
DEMO_DOMINIO=demo.seudominio.com.br
# senha única dos usuários de demonstração (10+ caracteres, letras e números)
DEMO_SENHA=TroqueEstaSenha2026
# domínio dos e-mails dos usuários de demo (admin@..., gestor.ti@... etc.)
DEMO_EMAIL_DOMINIO=demo.seudominio.com.br
# portão obrigatório: usuário/hash do Caddy antes da tela de login.
# Gere:  docker run --rm caddy:2 caddy hash-password --plaintext 'SENHA-DO-PORTAO'
# IMPORTANTE: no .env, cada '$' do hash deve ser escrito '$$' (ex.: $$2a$$14$$abc...)
DEMO_ACESSO_USER=demo
DEMO_ACESSO_HASH=
